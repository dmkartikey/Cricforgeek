{
  "name": "cricforgeek-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "record": "esbuild scripts/record.ts --bundle --platform=node --format=esm --outfile=scripts/.record.mjs --log-level=warning && node scripts/.record.mjs public/data"
  },
  "dependencies": {
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "react": "18.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/d3-array": "3.2.1",
    "@types/d3-scale": "4.0.8",
    "@types/d3-shape": "3.1.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.25.12",
    "typescript": "5.6.3",
    "vite": "6.4.4"
  }
}
